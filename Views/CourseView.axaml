<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="using:WestCoastEducationClient.ViewModels"
             x:Class="WestCoastEducationClient.Views.CourseView"
             x:DataType="vm:CourseViewModel">
  <StackPanel>

    <Design.DataContext>
      <vm:CourseViewModel></vm:CourseViewModel>
    </Design.DataContext>

    <TextBlock Text="Courses" HorizontalAlignment="Center"/>
    <Border BorderBrush="Black" BorderThickness="0 0 0 1" Padding="0 50 5 0">
      <Grid ColumnDefinitions="*,*,*,*" ShowGridLines="True">
        <Label Grid.Column="0" Content="Title" />
        <Label Grid.Column="1" Content="DurationDays" />
        <Label Grid.Column="2" Content="StartDate"/>
        <Label Grid.Column="3" Content="EndDate"/>
      </Grid>
    </Border>
    <ItemsControl ItemsSource="{Binding Courses}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Grid ColumnDefinitions="*,*,*,*," ShowGridLines="False">
            <Label Grid.Column="0" Content="{Binding Title}" />
            <Label Grid.Column="1" Content="{Binding DurationDays}" />
            <Label Grid.Column="2" Content="{Binding StartDate}"/>
            <Label Grid.Column="3" Content="{Binding EndDate}"/>
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>

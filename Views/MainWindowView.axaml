<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WestCoastEducationClient.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="WestCoastEducationClient.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="WestCoastEducationClient">

    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>

    <Grid ColumnDefinitions="Auto,*">
        <Border Grid.Column="0" Padding="10" Background="Blue">
            <StackPanel Spacing="10">
                <Button Command="{Binding GoToHomeCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Label Content="Home" Foreground="White" FontSize="16" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
                <Button Background="Purple" Command="{Binding GoToTeacherCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Label Content="Teacher" Foreground="White" FontSize="16" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
                <Button Background="Green" Command="{Binding GoToStudentCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Label Content="Student" Foreground="White" FontSize="16" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
                <Button Background="Orange" Command="{Binding GoToCoursesCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Label Content="Courses" Foreground="White" FontSize="16" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
        <ContentControl Grid.Column="1" Padding="20" Content="{Binding CurrentView}"/>
    </Grid>
</Window>


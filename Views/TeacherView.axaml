<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:WestCoastEducationClient.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="WestCoastEducationClient.Views.TeacherView"
             x:DataType="vm:TeacherViewModel">
  <StackPanel>

    <Design.DataContext>
      <vm:TeacherViewModel></vm:TeacherViewModel>
    </Design.DataContext>

    <TextBlock Text="Teachers" HorizontalAlignment="Center"/>
    <Border BorderBrush="Black" BorderThickness="0 0 0 1" Padding="0 50 5 0">
      <Grid ColumnDefinitions="*,*,*,*" ShowGridLines="True">
        <Label Grid.Column="0" Content="Firstname" />
        <Label Grid.Column="1" Content="Lastname" />
        <Label Grid.Column="2" Content="PersonalNumber"/>
        <Label Grid.Column="3" Content="KnowledgeArea"/>
      </Grid>
    </Border>
    <ItemsControl ItemsSource="{Binding Teachers}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Grid ColumnDefinitions="*,*,*,*," ShowGridLines="False">
            <Label Grid.Column="0" Content="{Binding FirstName}" />
            <Label Grid.Column="1" Content="{Binding LastName}" />
            <Label Grid.Column="2" Content="{Binding PersonalNumber}"/>
            <Label Grid.Column="3" Content="{Binding KnowledgeArea}"/>
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>


